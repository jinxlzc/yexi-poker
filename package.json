{
  "name": "yexi-poker",
  "version": "4.1.0",
  "private": false,
  "type": "module",
  "description": "夜席 Yexi：线下德州扑克局域网牌桌，手机扫码记虚拟筹码。Self-hosted Texas Hold'em poker table for home games.",
  "engines": {
    "node": ">=22.13.0"
  },
